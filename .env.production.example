# Production Environment Variables for aimodels.cloud API
# Copy this file to .env.production and fill in the values

# Application
ENVIRONMENT=production
LOG_LEVEL=INFO
API_PORT=8000

# Database (AWS RDS PostgreSQL)
DATABASE_URL=postgresql://aimodels_user:CHANGE_ME@db.rds.amazonaws.com:5432/aimodels_prod
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Redis (AWS ElastiCache)
REDIS_URL=redis://cache.elasticsearch.amazonaws.com:6379/0
REDIS_TTL=3600

# API Configuration
ALLOWED_ORIGINS=https://aimodels.cloud,https://www.aimodels.cloud,https://dashboard.aimodels.cloud
API_URL=https://api.aimodels.cloud
CORS_CREDENTIALS=true

# AI Provider API Keys (Encrypted in AWS Secrets Manager)
OPENAI_API_KEY=sk-CHANGE_ME
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
TOGETHER_API_KEY=CHANGE_ME

# Stripe (Billing & Payments)
STRIPE_API_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
S3_BUCKET=aimodels-prod-storage
S3_REGION=us-east-1

# Security & Auth
JWT_SECRET=CHANGE_ME_TO_RANDOM_STRING_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
API_KEY_PREFIX=sk-

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=3600
RATE_LIMIT_PER_DAY=86400

# Monitoring & Logging
CLOUDWATCH_LOG_GROUP=/ecs/aimodels-api
CLOUDWATCH_REGION=us-east-1
SENTRY_DSN=https://CHANGE_ME@sentry.io/PROJECT_ID
DATADOG_API_KEY=CHANGE_ME

# Feature Flags
ENABLE_WEBHOOKS=true
ENABLE_BILLING=true
ENABLE_CUSTOM_MODELS=true
ENABLE_BATCH_INFERENCE=true

# Model Serving Configuration
INFERENCE_TIMEOUT=300
INFERENCE_MAX_RETRIES=3
VLLM_SERVER_URL=http://vllm-server:8000
RAY_CLUSTER_URL=http://ray-cluster:8265

# Email Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.CHANGE_ME
NOTIFY_EMAIL=support@aimodels.cloud

# Analytics
POSTHOG_API_KEY=CHANGE_ME
AMPLITUDE_API_KEY=CHANGE_ME

# Deployment Settings
DEPLOYMENT_ENVIRONMENT=production
ECS_CLUSTER_NAME=aimodels-prod
ECS_SERVICE_NAME=aimodels-api
ECS_TASK_FAMILY=aimodels-api
