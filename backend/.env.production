# Production Environment Configuration
# CRITICAL: All secrets should come from AWS Secrets Manager
# DO NOT store real production keys in this file

ENVIRONMENT=production
LOG_LEVEL=INFO
API_PORT=8000
ALLOWED_ORIGINS=https://api.aimodels.cloud,https://app.aimodels.cloud

# ============================================================================
# PRODUCTION SECRETS - Use AWS Secrets Manager
# ============================================================================
# Set AWS_SECRETS_MANAGER_ENABLED=true and provider will load from AWS
# DO NOT paste real keys here - this file is checked into git

OPENAI_API_KEY=set_via_aws_secrets_manager
ANTHROPIC_API_KEY=set_via_aws_secrets_manager
TOGETHER_API_KEY=set_via_aws_secrets_manager

# ============================================================================
# Database Configuration (Production RDS)
# ============================================================================
# Connection string comes from AWS Secrets Manager
DATABASE_URL=set_via_aws_secrets_manager
DATABASE_POOL_SIZE=30
DATABASE_POOL_RECYCLE_SECONDS=3600
DATABASE_ECHO=false

# Redis (Production ElastiCache)
REDIS_URL=set_via_aws_secrets_manager
REDIS_DECODE_RESPONSES=true
REDIS_SOCKET_TIMEOUT=10
REDIS_SOCKET_CONNECT_TIMEOUT=10

# ============================================================================
# Billing (Stripe Production)
# ============================================================================
STRIPE_API_KEY=set_via_aws_secrets_manager
STRIPE_WEBHOOK_KEY=set_via_aws_secrets_manager
STRIPE_API_VERSION=2023-10-16

# ============================================================================
# AWS Secrets Manager Configuration (REQUIRED for Production)
# ============================================================================
AWS_SECRETS_MANAGER_ENABLED=true
AWS_REGION=us-east-1
AWS_SECRETS_MANAGER_REGION=us-east-1
AWS_SECRETS_MANAGER_SECRET_NAME=aimodels/production/api-keys

# Optional: Pin to specific version for controlled rollout
# AWS_SECRETS_MANAGER_SECRET_VERSION_ID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# ============================================================================
# Security Configuration
# ============================================================================
# JWT secret MUST be in Secrets Manager, generated offline
JWT_SECRET_KEY=set_via_aws_secrets_manager
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Rate Limiting (strict in production)
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# ============================================================================
# Monitoring & Observability
# ============================================================================
SENTRY_DSN=https://production-key@sentry.io/production-project-id
POSTHOG_API_KEY=phc_production_key
POSTHOG_API_HOST=https://us.posthog.com
CLOUDWATCH_LOG_GROUP=/aimodels/production
CLOUDWATCH_ENABLED=true

# ============================================================================
# API Configuration
# ============================================================================
API_VERSION=v1
MODEL_SERVING_BACKEND=vllm
VLLM_API_URL=http://prod-vllm.aimodels.internal:8001

# ============================================================================
# Logging (Restricted in Production)
# ============================================================================
LOG_REQUESTS=true
LOG_RESPONSES=false
LOG_API_KEYS=false

# ============================================================================
# Safety Settings (STRICT for Production)
# ============================================================================
DEBUG=false
RELOAD=false
VERBOSE=false

# ============================================================================
# Deployment Notes
# ============================================================================
# This file is deployed as-is. All sensitive values are sourced from:
#   AWS Secrets Manager: aimodels/production/api-keys
#
# To deploy production:
#   1. Verify secrets exist in AWS Secrets Manager
#   2. Verify IAM role has permission to read secrets
#   3. Deploy with: ./scripts/deploy.sh production
#   4. Monitor: aws logs tail /aimodels/production --follow
#
# Key rotation procedure: docs/KEY_ROTATION_GUIDE.md
# Emergency procedures: docs/EMERGENCY_ROTATION_PLAYBOOK.md
