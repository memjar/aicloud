# Staging Environment Configuration
# Mirrors production but with isolated resources and test keys

ENVIRONMENT=staging
LOG_LEVEL=INFO
API_PORT=8000
ALLOWED_ORIGINS=https://staging.aimodels.cloud,https://app-staging.aimodels.cloud

# LLM Provider Keys (Staging - use test/staging credentials)
# These should be isolated test accounts or restricted keys
OPENAI_API_KEY=sk_live_staging_key_from_test_account
ANTHROPIC_API_KEY=sk_ant_staging_key_from_test_account
TOGETHER_API_KEY=staging_key_from_test_account

# Staging Database (separate from production)
# Typically an RDS instance
DATABASE_URL=postgresql://admin:password@staging-db.aimodels.internal:5432/aimodels_staging
DATABASE_POOL_SIZE=15
DATABASE_POOL_RECYCLE_SECONDS=3600
DATABASE_ECHO=false

# Staging Redis (separate from production)
REDIS_URL=redis://staging-redis.aimodels.internal:6379/1
REDIS_DECODE_RESPONSES=true

# Stripe (use test keys but same account as production for testing billing flows)
STRIPE_API_KEY=sk_test_staging_key_from_stripe_test_mode
STRIPE_WEBHOOK_KEY=whsec_test_staging_from_stripe_webhook

# AWS Configuration for Staging
AWS_SECRETS_MANAGER_ENABLED=true
AWS_REGION=us-east-1
AWS_SECRETS_MANAGER_SECRET_NAME=aimodels/staging/keys
AWS_SECRETS_MANAGER_REGION=us-east-1

# JWT Configuration (use different secret than production)
JWT_SECRET_KEY=set_via_aws_secrets_manager_for_staging
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Rate Limiting (slightly more restrictive than dev, less than prod)
RATE_LIMIT_REQUESTS_PER_MINUTE=150
RATE_LIMIT_REQUESTS_PER_HOUR=3000

# Observability (enable but route to staging endpoints)
SENTRY_DSN=https://staging-key@sentry.io/staging-project-id
POSTHOG_API_KEY=phc_staging_key
POSTHOG_API_HOST=https://us.posthog.com
CLOUDWATCH_LOG_GROUP=/aimodels/staging
CLOUDWATCH_ENABLED=true

# API Configuration
API_VERSION=v1
MODEL_SERVING_BACKEND=vllm
VLLM_API_URL=http://staging-vllm.aimodels.internal:8001

# Logging
LOG_REQUESTS=true
LOG_RESPONSES=false
LOG_API_KEYS=false

# Development Features (enable for testing)
DEBUG=false
RELOAD=false
VERBOSE=false
