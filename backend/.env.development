# Development Environment Configuration
# Used for local development only

ENVIRONMENT=development
LOG_LEVEL=DEBUG
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# LLM Provider Keys (Development - can use test keys)
OPENAI_API_KEY=sk_test_dev_key_replace_with_real_test_key
ANTHROPIC_API_KEY=sk_ant_test_dev_key_replace_with_real_test_key
TOGETHER_API_KEY=test_dev_key_replace_with_real_test_key

# Local Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aimodels_dev
DATABASE_POOL_SIZE=5
DATABASE_POOL_RECYCLE_SECONDS=3600
DATABASE_ECHO=true

# Local Redis
REDIS_URL=redis://localhost:6379/0
REDIS_DECODE_RESPONSES=true

# Stripe (use test keys from https://dashboard.stripe.com/account/apikeys)
STRIPE_API_KEY=sk_test_dev_replace_with_real_test_key
STRIPE_WEBHOOK_KEY=whsec_test_dev_replace_with_real_test_key

# AWS (optional for local development)
AWS_SECRETS_MANAGER_ENABLED=false
AWS_REGION=us-east-1

# JWT (development can use auto-generated)
JWT_SECRET_KEY=dev_secret_key_min_32_chars_required_for_testing
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Rate Limiting (lenient for local dev)
RATE_LIMIT_REQUESTS_PER_MINUTE=600
RATE_LIMIT_REQUESTS_PER_HOUR=10000

# Observability (optional for local)
SENTRY_DSN=
POSTHOG_API_KEY=
CLOUDWATCH_ENABLED=false

# API Configuration
API_VERSION=v1
MODEL_SERVING_BACKEND=vllm
VLLM_API_URL=http://localhost:8001

# Logging
LOG_REQUESTS=true
LOG_RESPONSES=true
LOG_API_KEYS=false

# Development Settings
DEBUG=true
RELOAD=true
VERBOSE=true
